{{- $pathVars := dict -}}
{{- template "path-list.tmpl" (dict "Root" . "Vars" $pathVars) -}}
{{- $pathList := index $pathVars "pathList" -}}

{{ if findExecutable "claude" $pathList }}

clsc() {
    local profile="${1:-${USER}}"
    case "$profile" in
        ''|*[!a-zA-Z0-9_-]*)
            print -u2 "Usage: $0 [profile: letters, numbers, underscores, hyphens]"
            return 1
            ;;
    esac
    export CLAUDE_CONFIG_DIR="${HOME}/.claude/${profile}/claude-code"

    echo "CLAUDE_CONFIG_DIR set to: $CLAUDE_CONFIG_DIR"
}

{{- end -}}
