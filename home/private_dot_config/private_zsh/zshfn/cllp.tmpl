{{ if eq .chezmoi.os "darwin" }}
cllp() {
  local profile="${1:-${USER}}"

  case "$profile" in
    ''|*[!a-zA-Z0-9_-]*)
      print -u2 "Usage: $0 [profile: letters, numbers, underscores, hyphens]"
      return 1
      ;;
  esac

  /usr/bin/open -n \
    --env "CLAUDE_CONFIG_DIR=${HOME}/.claude/${profile}/claude-code" \
    "/Applications/Claude.app" \
    --args "--user-data-dir=${HOME}/.claude/${profile}/app"
}
{{- end }}
